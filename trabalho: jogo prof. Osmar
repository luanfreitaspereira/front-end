<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VS Code Parkour 2D - Ultimate Edition</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #1e1e1e;
      color: #d4d4d4;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
    }
    #game-container {
      position: relative;
    }
    canvas {
      background-color: #252526;
      border: 2px solid #007acc;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
      display: block;
    }
    #ui {
      position: absolute;
      top: 10px;
      left: 10px;
      right: 10px;
      display: flex;
      justify-content: space-between;
      font-weight: bold;
      font-size: 15px;
      color: #569cd6;
      pointer-events: none;
    }
    .stats {
      color: #4ec9b0;
    }
    .controls-info {
      margin-top: 10px;
      font-size: 13px;
      color: #858585;
      text-align: center;
    }
  </style>
</head>
<body>

  <div id="game-container">
    <div id="ui">
      <span id="level-txt">Fase: 1 / 6</span>
      <span class="stats">Tempo: <span id="timer-txt">0.0s</span> | Mortes: <span id="deaths-txt">0</span></span>
      <span id="status-txt">Controles: A,D / Setas | Espaço = Pulo | Shift = Dash</span>
    </div>
    <canvas id="gameCanvas" width="800" height="450"></canvas>
  </div>

  <div class="controls-info">
    <b>Mecânicas:</b> [Espaço/W] Pulo Duplo / Wall Jump | [Shift] Dash | [R] Reiniciar Fase
  </div>

  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const levelTxt = document.getElementById('level-txt');
    const timerTxt = document.getElementById('timer-txt');
    const deathsTxt = document.getElementById('deaths-txt');
    const statusTxt = document.getElementById('status-txt');

    // Configurações do Jogo
    const GRAVITY = 0.5;
    let currentLevel = 0;
    let keys = {};
    let particles = [];
    let trail = [];
    let bullets = [];
    let totalDeaths = 0;
    let startTime = Date.now();
    let laserWarning = 0;

    // Jogador
    const player = {
      x: 50,
      y: 300,
      width: 24,
      height: 32,
      vx: 0,
      vy: 0,
      speed: 4.5,
      jumpForce: -10,
      grounded: false,
      jumpsLeft: 2,
      isTouchingWallLeft: false,
      isTouchingWallRight: false,
      isDashing: false,
      dashCooldown: 0,
      dashTimer: 0,
      facingRight: true,
      color: '#007acc',
      collectedBlocks: 0
    };

    // Definição das 6 Fases
    const levels = [
      // Fase 1: Introdução + Trampolim
      {
        start: { x: 50, y: 350 },
        exit: { x: 730, y: 150, w: 30, h: 40 },
        platforms: [
          { x: 0, y: 400, w: 200, h: 50, type: 'normal' },
          { x: 250, y: 330, w: 120, h: 20, type: 'normal' },
          { x: 420, y: 260, w: 120, h: 20, type: 'normal' },
          { x: 580, y: 190, w: 180, h: 20, type: 'normal' }
        ],
        springs: [{ x: 300, y: 320, w: 25, h: 10, power: -14 }],
        hazards: [],
        items: [],
        boss: null
      },
      // Fase 2: Plataformas Móveis e Desmoronáveis
      {
        start: { x: 40, y: 380 },
        exit: { x: 740, y: 80, w: 30, h: 40 },
        platforms: [
          { x: 0, y: 420, w: 120, h: 30, type: 'normal' },
          { x: 180, y: 350, w: 80, h: 20, type: 'crumbling', time: 0, broken: false },
          { x: 320, y: 280, w: 80, h: 20, type: 'moving', range: 100, speed: 2, startX: 320, dir: 1 },
          { x: 500, y: 210, w: 80, h: 20, type: 'crumbling', time: 0, broken: false },
          { x: 650, y: 140, w: 100, h: 20, type: 'normal' }
        ],
        springs: [],
        hazards: [{ x: 0, y: 440, w: 800, h: 10 }],
        items: [],
        boss: null
      },
      // Fase 3: Wall Jump em Poço Vertical
      {
        start: { x: 40, y: 400 },
        exit: { x: 720, y: 60, w: 30, h: 40 },
        platforms: [
          { x: 0, y: 430, w: 120, h: 20, type: 'normal' },
          { x: 200, y: 200, w: 20, h: 250, type: 'normal' }, // Parede 1
          { x: 320, y: 150, w: 20, h: 250, type: 'normal' }, // Parede 2
          { x: 450, y: 250, w: 100, h: 20, type: 'normal' },
          { x: 650, y: 100, w: 120, h: 20, type: 'normal' }
        ],
        springs: [],
        hazards: [{ x: 0, y: 440, w: 800, h: 10 }],
        items: [],
        boss: null
      },
      // Fase 4: Dash sobre Abismos Espaçados
      {
        start: { x: 30, y: 200 },
        exit: { x: 740, y: 200, w: 30, h: 40 },
        platforms: [
          { x: 10, y: 240, w: 80, h: 20, type: 'normal' },
          { x: 200, y: 240, w: 40, h: 20, type: 'normal' },
          { x: 380, y: 240, w: 40, h: 20, type: 'normal' },
          { x: 560, y: 240, w: 40, h: 20, type: 'normal' },
          { x: 710, y: 240, w: 80, h: 20, type: 'normal' }
        ],
        springs: [],
        hazards: [{ x: 0, y: 440, w: 800, h: 10 }],
        items: [],
        boss: null
      },
      // Fase 5: O Desafio de Agilidade Combinado
      {
        start: { x: 30, y: 380 },
        exit: { x: 730, y: 60, w: 30, h: 40 },
        platforms: [
          { x: 10, y: 420, w: 80, h: 20, type: 'normal' },
          { x: 140, y: 350, w: 60, h: 20, type: 'moving', range: 80, speed: 3, startX: 140, dir: 1 },
          { x: 300, y: 280, w: 60, h: 20, type: 'crumbling', time: 0, broken: false },
          { x: 450, y: 200, w: 20, h: 180, type: 'normal' },
          { x: 580, y: 120, w: 100, h: 20, type: 'normal' }
        ],
        springs: [{ x: 320, y: 270, w: 20, h: 10, power: -13 }],
        hazards: [
          { x: 0, y: 440, w: 800, h: 10 },
          { x: 220, y: 400, w: 60, h: 20 }
        ],
        items: [],
        boss: null
      },
      // Fase 6: BOSS SUPREMO
      {
        start: { x: 50, y: 380 },
        exit: null,
        platforms: [
          { x: 0, y: 420, w: 800, h: 30, type: 'normal' },
          { x: 80, y: 320, w: 100, h: 15, type: 'normal' },
          { x: 250, y: 250, w: 100, h: 15, type: 'normal' },
          { x: 420, y: 320, w: 100, h: 15, type: 'normal' },
          { x: 580, y: 220, w: 120, h: 15, type: 'normal' },
          { x: 150, y: 160, w: 120, h: 15, type: 'normal' }
        ],
        springs: [{ x: 350, y: 410, w: 30, h: 10, power: -12 }],
        hazards: [{ x: 200, y: 405, w: 120, h: 15 }],
        items: [
          { x: 110, y: 290, w: 20, h: 20, collected: false },
          { x: 280, y: 220, w: 20, h: 20, collected: false },
          { x: 450, y: 290, w: 20, h: 20, collected: false },
          { x: 620, y: 190, w: 20, h: 20, collected: false },
          { x: 190, y: 130, w: 20, h: 20, collected: false }
        ],
        boss: {
          x: 700,
          y: 330,
          w: 60,
          h: 90,
          hp: 5,
          maxHp: 5,
          shootTimer: 0,
          shootInterval: 80,
          attackMode: 'normal', // 'normal', 'rain', 'laser'
          laserTimer: 0
        }
      }
    ];

    // Controles por Teclado
    window.addEventListener('keydown', (e) => {
      if (!keys[e.code]) {
        if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') handleJump();
        if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') handleDash();
      }
      keys[e.code] = true;
      if (e.code === 'KeyR') resetLevel();
    });

    window.addEventListener('keyup', (e) => {
      keys[e.code] = false;
    });

    function handleJump() {
      // Wall Jump
      if (player.isTouchingWallLeft) {
        player.vy = player.jumpForce;
        player.vx = player.speed * 1.5;
        createParticles(player.x, player.y + 16, '#fff', 5);
        return;
      }
      if (player.isTouchingWallRight) {
        player.vy = player.jumpForce;
        player.vx = -player.speed * 1.5;
        createParticles(player.x + player.width, player.y + 16, '#fff', 5);
        return;
      }

      // Pulo Normal e Pulo Duplo
      if (player.jumpsLeft > 0) {
        player.vy = player.jumpForce;
        player.jumpsLeft--;
        createParticles(player.x + player.width / 2, player.y + player.height, '#569cd6', 6);
      }
    }

    function handleDash() {
      if (player.dashCooldown <= 0 && !player.isDashing) {
        player.isDashing = true;
        player.dashTimer = 10;
        player.dashCooldown = 45;
        player.vy = 0;
      }
    }

    function loadLevel(lvlIndex) {
      currentLevel = lvlIndex;
      const lvl = levels[currentLevel];
      
      player.x = lvl.start.x;
      player.y = lvl.start.y;
      player.vx = 0;
      player.vy = 0;
      player.collectedBlocks = 0;
      player.dashCooldown = 0;
      player.isDashing = false;

      bullets = [];
      laserWarning = 0;
      
      // Reseta plataformas quebradiças
      lvl.platforms.forEach(p => {
        if (p.type === 'crumbling') {
          p.broken = false;
          p.time = 0;
        }
      });

      if (lvl.items) lvl.items.forEach(i => i.collected = false);
      if (lvl.boss) {
        lvl.boss.hp = lvl.boss.maxHp;
        lvl.boss.shootTimer = 0;
        lvl.boss.attackMode = 'normal';
      }

      updateUI();
    }

    function resetLevel() {
      totalDeaths++;
      deathsTxt.innerText = totalDeaths;
      loadLevel(currentLevel);
    }

    function updateUI() {
      levelTxt.innerText = `Fase: ${currentLevel + 1} / ${levels.length}`;
      if (currentLevel === 5) {
        const lvl = levels[5];
        statusTxt.innerText = `BOSS! Colete os blocos: ${player.collectedBlocks} / ${lvl.boss.maxHp}`;
        statusTxt.style.color = '#f14c4c';
      } else {
        statusTxt.innerText = `Controles: A,D / Setas | Espaço = Pulo | Shift = Dash`;
        statusTxt.style.color = '#569cd6';
      }
    }

    function createParticles(x, y, color, count) {
      for (let i = 0; i < count; i++) {
        particles.push({
          x: x, y: y,
          vx: (Math.random() - 0.5) * 4,
          vy: (Math.random() - 0.5) * 4,
          life: 20, color: color
        });
      }
    }

    function update() {
      const lvl = levels[currentLevel];

      // Atualiza cronômetro
      const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
      timerTxt.innerText = `${elapsed}s`;

      // Atualiza recargas
      if (player.dashCooldown > 0) player.dashCooldown--;

      // Lógica de Dash
      if (player.isDashing) {
        player.vx = (player.facingRight ? 1 : -1) * 12;
        player.vy = 0;
        player.dashTimer--;
        
        // Efeito de sombra
        trail.push({ x: player.x, y: player.y, alpha: 0.6 });

        if (player.dashTimer <= 0) player.isDashing = false;
      } else {
        // Movimento Horizontal Normal
        if (keys['ArrowRight'] || keys['KeyD']) {
          player.vx = player.speed;
          player.facingRight = true;
        } else if (keys['ArrowLeft'] || keys['KeyA']) {
          player.vx = -player.speed;
          player.facingRight = false;
        } else {
          player.vx = 0;
        }
        player.vy += GRAVITY;
      }

      // Atualiza Rastro do Dash
      for (let i = trail.length - 1; i >= 0; i--) {
        trail[i].alpha -= 0.08;
        if (trail[i].alpha <= 0) trail.splice(i, 1);
      }

      // Atualiza Plataformas Móveis e Quebradiças
      lvl.platforms.forEach(p => {
        if (p.type === 'moving') {
          p.x += p.speed * p.dir;
          if (Math.abs(p.x - p.startX) > p.range) p.dir *= -1;
        }
        if (p.type === 'crumbling' && p.time > 0 && !p.broken) {
          p.time++;
          if (p.time > 40) p.broken = true;
        }
      });

      // Detecção de Parede para Wall Jump
      player.isTouchingWallLeft = false;
      player.isTouchingWallRight = false;

      // Colisão Horizontal
      player.x += player.vx;
      lvl.platforms.forEach(p => {
        if (p.type === 'crumbling' && p.broken) return;
        if (
          player.x < p.x + p.w &&
          player.x + player.width > p.x &&
          player.y < p.y + p.h &&
          player.y + player.height > p.y
        ) {
          if (player.vx > 0) {
            player.x = p.x - player.width;
            player.isTouchingWallRight = true;
          } else if (player.vx < 0) {
            player.x = p.x + p.w;
            player.isTouchingWallLeft = true;
          }
        }
      });

      // Colisão Vertical
      player.y += player.vy;
      player.grounded = false;

      lvl.platforms.forEach(p => {
        if (p.type === 'crumbling' && p.broken) return;
        if (
          player.x < p.x + p.w &&
          player.x + player.width > p.x &&
          player.y < p.y + p.h &&
          player.y + player.height > p.y
        ) {
          if (player.vy > 0) {
            player.y = p.y - player.height;
            player.vy = 0;
            player.grounded = true;
            player.jumpsLeft = 2; // Restaura Pulo Duplo
            if (p.type === 'crumbling' && p.time === 0) p.time = 1;
          } else if (player.vy < 0) {
            player.y = p.y + p.h;
            player.vy = 0;
          }
        }
      });

      // Colisão com Molas / Trampolins
      if (lvl.springs) {
        lvl.springs.forEach(s => {
          if (
            player.x < s.x + s.w &&
            player.x + player.width > s.x &&
            player.y < s.y + s.h &&
            player.y + player.height > s.y
          ) {
            player.vy = s.power;
            player.jumpsLeft = 1;
            createParticles(s.x + s.w / 2, s.y, '#dcdcaa', 8);
          }
        });
      }

      // Deslizar na Parede (Wall Slide)
      if ((player.isTouchingWallLeft || player.isTouchingWallRight) && !player.grounded && player.vy > 0) {
        player.vy = 1.5; // Desce mais devagar
        player.jumpsLeft = 1;
      }

      // Limites do Mapa
      if (player.x < 0) player.x = 0;
      if (player.x + player.width > canvas.width) player.x = canvas.width - player.width;
      if (player.y > canvas.height) resetLevel();

      // Armadilhas e Espinhos
      lvl.hazards.forEach(h => {
        if (
          player.x < h.x + h.w &&
          player.x + player.width > h.x &&
          player.y < h.y + h.h &&
          player.y + player.height > h.y
        ) {
          resetLevel();
        }
      });

      // LÓGICA DO BOSS (Fase 6)
      if (lvl.boss && lvl.boss.hp > 0) {
        // Coleta dos Blocos
        lvl.items.forEach(item => {
          if (!item.collected) {
            if (
              player.x < item.x + item.w &&
              player.x + player.width > item.x &&
              player.y < item.y + item.h &&
              player.y + player.height > item.y
            ) {
              item.collected = true;
              player.collectedBlocks++;
              lvl.boss.hp--;
              updateUI();
              createParticles(item.x, item.y, '#ce9178', 12);

              if (lvl.boss.hp <= 0) {
                setTimeout(() => {
                  alert(`PARABÉNS! Você venceu o jogo em ${timerTxt.innerText} com ${totalDeaths} mortes!`);
                  totalDeaths = 0;
                  startTime = Date.now();
                  loadLevel(0);
                }, 100);
              }
            }
          }
        });

        // Padrões de Ataque do Boss
        lvl.boss.shootTimer++;

        // Modo de Fúria (Aumenta velocidade com pouca vida)
        const currentInterval = lvl.boss.hp <= 2 ? 50 : lvl.boss.shootInterval;

        if (lvl.boss.shootTimer >= currentInterval) {
          lvl.boss.shootTimer = 0;
          
          // Alterna ataques
          const rand = Math.random();
          if (rand < 0.5) {
            // Tiro Direcionado
            const angle = Math.atan2(
              (player.y + player.height / 2) - (lvl.boss.y + 20),
              (player.x + player.width / 2) - lvl.boss.x
            );
            bullets.push({
              x: lvl.boss.x, y: lvl.boss.y + 20,
              vx: Math.cos(angle) * 6, vy: Math.sin(angle) * 6,
              radius: 6, type: 'normal'
            });
          } else if (rand < 0.8) {
            // Chuva de Projéteis
            for (let i = 0; i < 3; i++) {
              bullets.push({
                x: 100 + i * 250 + Math.random() * 50, y: 0,
                vx: 0, vy: 4,
                radius: 8, type: 'rain'
              });
            }
          } else {
            // Disparo de Laser Horizontal Baixo
            laserWarning = 40; // Avisa antes de disparar
          }
        }

        // Execução do Laser com Aviso
        if (laserWarning > 0) {
          laserWarning--;
          if (laserWarning === 1) {
            bullets.push({
              x: 0, y: 390, w: 800, h: 20,
              vx: 0, vy: 0, duration: 20, type: 'laser'
            });
          }
        }
      }

      // Atualização de Projéteis do Boss
      for (let i = bullets.length - 1; i >= 0; i--) {
        let b = bullets[i];

        if (b.type === 'laser') {
          b.duration--;
          if (
            player.x < b.x + b.w &&
            player.x + player.width > b.x &&
            player.y < b.y + b.h &&
            player.y + player.height > b.y
          ) {
            resetLevel();
          }
          if (b.duration <= 0) bullets.splice(i, 1);
          continue;
        }

        b.x += b.vx;
        b.y += b.vy;

        // Colisão com jogador
        const dist = Math.hypot((player.x + player.width / 2) - b.x, (player.y + player.height / 2) - b.y);
        if (dist < b.radius + player.width / 2) {
          resetLevel();
        }

        if (b.x < 0 || b.x > canvas.width || b.y < 0 || b.y > canvas.height) {
          bullets.splice(i, 1);
        }
      }

      // Atualização de Partículas
      for (let i = particles.length - 1; i >= 0; i--) {
        let p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life--;
        if (p.life <= 0) particles.splice(i, 1);
      }

      // Avançar de Fase Normal
      if (lvl.exit) {
        if (
          player.x < lvl.exit.x + lvl.exit.w &&
          player.x + player.width > lvl.exit.x &&
          player.y < lvl.exit.y + lvl.exit.h &&
          player.y + player.height > lvl.exit.y
        ) {
          loadLevel(currentLevel + 1);
        }
      }
    }

    function render() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const lvl = levels[currentLevel];

      // Desenha Plataformas
      lvl.platforms.forEach(p => {
        if (p.type === 'crumbling' && p.broken) return;

        if (p.type === 'crumbling') ctx.fillStyle = p.time > 0 ? '#d16969' : '#ce9178';
        else if (p.type === 'moving') ctx.fillStyle = '#4ec9b0';
        else ctx.fillStyle = '#3c3c3c';

        ctx.fillRect(p.x, p.y, p.w, p.h);
        ctx.strokeStyle = '#007acc';
        ctx.strokeRect(p.x, p.y, p.w, p.h);
      });

      // Desenha Molas / Trampolins
      if (lvl.springs) {
        ctx.fillStyle = '#dcdcaa';
        lvl.springs.forEach(s => ctx.fillRect(s.x, s.y, s.w, s.h));
      }

      // Perigos / Espinhos
      ctx.fillStyle = '#f14c4c';
      lvl.hazards.forEach(h => ctx.fillRect(h.x, h.y, h.w, h.h));

      // Portal de Saída
      if (lvl.exit) {
        ctx.fillStyle = '#4ec9b0';
        ctx.fillRect(lvl.exit.x, lvl.exit.y, lvl.exit.w, lvl.exit.h);
      }

      // Blocos do Boss
      if (lvl.items) {
        lvl.items.forEach(item => {
          if (!item.collected) {
            ctx.fillStyle = '#ce9178';
            ctx.fillRect(item.x, item.y, item.w, item.h);
            ctx.strokeStyle = '#fff';
            ctx.strokeRect(item.x, item.y, item.w, item.h);
          }
        });
      }

      // Boss
      if (lvl.boss && lvl.boss.hp > 0) {
        ctx.fillStyle = lvl.boss.hp <= 2 ? '#ff0000' : '#f14c4c'; // Fúria
        ctx.fillRect(lvl.boss.x, lvl.boss.y, lvl.boss.w, lvl.boss.h);

        // Barra de Vida
        ctx.fillStyle = '#555';
        ctx.fillRect(lvl.boss.x, lvl.boss.y - 15, lvl.boss.w, 8);
        ctx.fillStyle = '#f14c4c';
        ctx.fillRect(lvl.boss.x, lvl.boss.y - 15, (lvl.boss.w * lvl.boss.hp) / lvl.boss.maxHp, 8);
      }

      // Aviso do Laser
      if (laserWarning > 0) {
        ctx.fillStyle = 'rgba(241, 76, 76, 0.3)';
        ctx.fillRect(0, 390, 800, 20);
      }

      // Projéteis
      bullets.forEach(b => {
        if (b.type === 'laser') {
          ctx.fillStyle = '#ff0000';
          ctx.fillRect(b.x, b.y, b.w, b.h);
        } else {
          ctx.fillStyle = b.type === 'rain' ? '#dcdcaa' : '#f14c4c';
          ctx.beginPath();
          ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
          ctx.fill();
        }
      });

      // Rastro do Dash
      trail.forEach(t => {
        ctx.fillStyle = `rgba(0, 122, 204, ${t.alpha})`;
        ctx.fillRect(t.x, t.y, player.width, player.height);
      });

      // Partículas
      particles.forEach(p => {
        ctx.fillStyle = p.color;
        ctx.fillRect(p.x, p.y, 4, 4);
      });

      // Jogador
      ctx.fillStyle = player.isDashing ? '#9cdcfe' : player.color;
      ctx.fillRect(player.x, player.y, player.width, player.height);
    }

    function gameLoop() {
      update();
      render();
      requestAnimationFrame(gameLoop);
    }

    loadLevel(0);
    gameLoop();
  </script>
</body>
</html>
